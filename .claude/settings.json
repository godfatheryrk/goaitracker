{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pint-on-edit.php\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-on-edit.php\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
